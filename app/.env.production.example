# Copie este arquivo para .env no servidor de produção e preencha os valores reais.
# NUNCA versione o .env final nem o compartilhe fora do time responsável pela infraestrutura.

# Porta em que a API Node/Express escuta. O proxy reverso (Nginx/IIS) aponta para ela.
PORT=3001

# --- Banco de dados (MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sis_cred
# Gere uma senha forte e exclusiva para produção (não reaproveite a de desenvolvimento).
DB_PASSWORD=
DB_NAME=sis_cred

# --- CORS ---
# Domínio público (com https://) de onde o frontend é servido.
CORS_ORIGIN=https://app.suaempresa.com.br

# --- Proxy reverso ---
# Defina como 1 quando a API rodar atrás de um único proxy reverso confiável (Nginx/IIS),
# conforme os guias em docs/deploy-linux.md e docs/deploy-windows.md. Isso é necessário para
# que o limitador de tentativas de login identifique o IP real do cliente, não o do proxy.
# Deixe em branco se a API for exposta diretamente (sem proxy) — o padrão já é seguro.
TRUST_PROXY=1

# --- Autenticação ---
# Gere com: openssl rand -base64 48 (Linux) ou:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 })) (PowerShell)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- E-mail (SMTP) ---
# Use uma conta/domínio dedicado ao envio transacional em produção, com senha de app própria.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sis-Cred Cadastro e Crédito" <naoresponda@suaempresa.com.br>

# --- API do Prático (busca do cadastro do cliente) ---
PRATICO_API_URL=http://192.168.0.8:8080
PRATICO_API_USER=
PRATICO_API_PASSWORD=
# Opcional: restringe a busca a uma empresa (cd_empresa) do Prático
PRATICO_CD_EMPRESA=

# --- Verificação de atualização (Admin > Atualizações do sistema) ---
# owner/repo do GitHub. Sem isso, o painel simplesmente não mostra o card de atualização.
# Este é só um AVISO — a atualização em si continua sendo aplicada por SSH com
# deploy/linux/update.sh (ver docs/deploy-linux.md), o processo da API não baixa nem
# instala nada sozinho.
GITHUB_REPO=kevynmartins/sis-cred
GITHUB_BRANCH=main
# Opcional: só é necessário se o repositório for privado, ou para evitar o limite de taxa
# baixo da API do GitHub sem autenticação (60 req/hora por IP).
GITHUB_TOKEN=
