<?xml version="1.0" encoding="UTF-8"?>
<!--
  Coloque este arquivo em C:\sis-cred\dist\web.config.
  Requer os módulos IIS "URL Rewrite" e "Application Request Routing" (ARR) instalados,
  com "Enable proxy" habilitado em ARR (Server Proxy Settings).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Proxy reverso: /api/* -> API Node local em 127.0.0.1:3001 -->
        <rule name="ReverseProxyApi" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:3001/api/{R:1}" />
        </rule>

        <!-- SPA fallback: qualquer rota que não seja arquivo/pasta existente cai no index.html -->
        <rule name="SpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Compressão e cache para os assets com hash gerados pelo Vite -->
    <urlCompression doDynamicCompression="true" doStaticCompression="true" />
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!-- Limite de upload (documentos PDF até 15 MB conforme server/index.ts) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>

    <!--
      A API usa Server-Sent Events (atualização em tempo real) em /api/events, uma
      conexão longa e contínua. Sem isso, o ARR pode "segurar" a resposta em buffer
      e fechar a conexão antes da hora, e a tela deixa de atualizar sozinha.
      Se esta seção der erro ao salvar (depende da versão do IIS/ARR), configure o
      equivalente pela interface: IIS Manager → nível do SERVIDOR → "Application
      Request Routing Cache" → "Server Proxy Settings" → desmarque/zere o buffer de
      resposta e aumente o tempo limite.
    -->
    <proxy enabled="true" responseBufferThreshold="0" timeout="00:60:00" />
  </system.webServer>
</configuration>
