[Unit]
Description=Sis-Cred API (Node/Express)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=siscred
Group=siscred
WorkingDirectory=/opt/sis-cred/app
EnvironmentFile=/opt/sis-cred/app/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/sis-cred/app/dist-server/index.js
Restart=on-failure
RestartSec=5
# Endurecimento básico do sandbox systemd
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
